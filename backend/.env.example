# Base de datos PostgreSQL (Neon recomendado)
DATABASE_URL="postgresql://user:password@host:5432/viaschoco"

# Autenticación JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRATION="8h"

# Admin Principal
ADMIN_EMAIL="alrxandermaturana76.admin@gmail.com"
ADMIN_PASSWORD="change-this-password"

# Admins Adicionales (registrar manualmente después del deploy)
# ADMIN_2_EMAIL="otro.admin@viaschoco.app"
# ADMIN_3_EMAIL="tercer.admin@viaschoco.app"
# ADMIN_4_EMAIL="cuarto.admin@viaschoco.app"
# ADMIN_5_EMAIL="quinto.admin@viaschoco.app"

# MQTT Broker (HiveMQ Cloud o EMQX)
MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
MQTT_USERNAME="optional"
MQTT_PASSWORD="optional"
MQTT_TOPIC_PREFIX="viaschoco/"

# OpenWeatherMap (opcional)
OPENWEATHER_API_KEY="your_api_key_here"

# Puerto
PORT=3001

# Entorno
NODE_ENV="development"
